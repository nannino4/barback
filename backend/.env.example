NODE_ENV=dev
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:5173

# database
MONGODB_URI=mongodb://localhost:27017/barback_example?replicaSet=rs0&retryWrites=true&w=majority

# JWT
JWT_ACCESS_TOKEN_SECRET=yourSuperSecretKey
JWT_ACCESS_TOKEN_EXPIRATION_TIME=15m
JWT_REFRESH_TOKEN_SECRET=yourSuperSecretRefreshKey
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d
JWT_OAUTH_STATE_SECRET=yourSuperSecretOAuthStateKey
JWT_OAUTH_STATE_EXPIRATION_TIME=10m

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_BASIC_MONTHLY_PRICE_ID=price_your_basic_monthly_plan_price_id_here
STRIPE_BASIC_YEARLY_PRICE_ID=price_your_basic_yearly_plan_price_id_here

# Email Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-email@ethereal.email
SMTP_PASS=your-ethereal-password
EMAIL_FROM=noreply@barback.app

# Email Settings
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=1h

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/oauth/google/callback

# Storage (S3-compatible) - used for user profile pictures
USER_PROFILE_PICTURE_MAX_BYTES=5242880
S3_REGION=us-east-1
S3_BUCKET=barback-example
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# Optional for S3-compatible providers (MinIO, Cloudflare R2, etc.)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Base URL where objects are publicly reachable (recommended, e.g. CDN or bucket public URL)
S3_PUBLIC_BASE_URL=https://cdn.example.com
