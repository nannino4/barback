# Docker Hub account used by deploy script for pull/login
DOCKER_HUB_USERNAME=yourdockerhubuser
DOCKER_HUB_TOKEN=your_dockerhub_access_token_optional

# Image tags to deploy (usually commit SHA or dev)
BACKEND_IMAGE_TAG=dev
FRONTEND_IMAGE_TAG=dev

# Backend runtime env file path on EC2
BACKEND_ENV_FILE=/opt/barback/secrets/backend.dev.env

# TLS / certbot
CERTBOT_DOMAIN=barback.it
CERTBOT_WWW_DOMAIN=www.barback.it
CERTBOT_EMAIL=devops@barback.it
LETSENCRYPT_LIVE_PATH=/etc/letsencrypt/live/barback.it

# Optional overrides
ROOT_DIR=/opt/barback
COMPOSE_FILE=/opt/barback/deploy/docker-compose.dev.yml
